generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())

  report      Report[]
  user        User[]
}

model User {
  id            Int      @id @default(autoincrement())
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     Int?
  name          String
  email         String   @unique
  password      String?
  provider      String?
  isOAuth       Boolean  @default(false)
  role          String   @default("user")
  avatar        String?
  firstLogin    Boolean  @default(true)
  createdAt     DateTime @default(now())

  tokens    Token[]
}

model Token {
  id           Int      @id @default(autoincrement())
  accessToken  String
  refreshToken String
  expiresIn    DateTime

  user         User?    @relation(fields: [userId], references: [id])
  userId       Int?
}

model Report {
  id          Int     @id @default(autoincrement())
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     Int?
  reportName  String
  dateRange   String
  rows        ReportRow[]
}

model ReportRow {
  id                      Int     @id @default(autoincrement())
  report                  Report? @relation(fields: [reportId], references: [id])
  reportId                Int?
  key                     String
  value                   String
}
