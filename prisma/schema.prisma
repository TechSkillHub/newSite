generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  label       String
  createdAt   DateTime @default(now())

  serviceCompany        ServiceCompany[]
}



model Company {
  id                    Int      @id @default(autoincrement())
  name                  String
  createdAt             DateTime @default(now())

  serviceCompany        ServiceCompany[]
  report                Report[]
  user                  User[]
}

model ServiceCompany {
  id                Int     @id @default(autoincrement())
  company           Company @relation(fields: [companyId], references: [id])
  companyId         Int
  service           Service @relation(fields: [serviceId], references: [id])
  serviceId         Int
  value             Float
  description       String
  validity          Int
  paymentFrequency  PaymentFrequency
  createdAt         DateTime @default(now())
}

enum PaymentFrequency {
  UNITARY
  RECURRENT
}

model User {
  id            Int      @id @default(autoincrement())
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     Int?
  name          String
  email         String   @unique
  password      String?
  provider      String?
  isOAuth       Boolean  @default(false)
  role          Role     @default(value: USER)
  avatar        String?
  firstLogin    Boolean  @default(true)
  createdAt     DateTime @default(now())

  tokens    Token[]
}

enum Role {
  USER
  ADMIN
}

model Token {
  id           Int      @id @default(autoincrement())
  accessToken  String
  refreshToken String
  expiresIn    DateTime

  user         User?    @relation(fields: [userId], references: [id])
  userId       Int?
}

model Report {
  id          Int     @id @default(autoincrement())
  company       Company? @relation(fields: [companyId], references: [id])
  companyId     Int?
  reportName  String
  dateRange   String
  rows        ReportRow[]
}

model ReportRow {
  id                      Int     @id @default(autoincrement())
  report                  Report? @relation(fields: [reportId], references: [id])
  reportId                Int?
  key                     String
  value                   String
}
