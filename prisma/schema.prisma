generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  provider  String?
  isOAuth   Boolean  @default(false)
  role      String   @default("user")
  avatar    String?
  createdAt DateTime @default(now())

  tokens    Token[]
}

model Token {
  id           Int      @id @default(autoincrement())
  accessToken  String
  refreshToken String
  expiresIn    DateTime

  user         User?    @relation(fields: [userId], references: [id])
  userId       Int?
}

model Report {
  id          Int     @id @default(autoincrement())
  reportName  String
  dateRange   String
  rows        Row[]
}

model Row {
  id                      Int     @id @default(autoincrement())
  report                  Report? @relation(fields: [reportId], references: [id])
  reportId                Int?
  statusDaCampanha        String
  campanha                String
  nomeDoOrcamento         String
  codigoDaMoeda           String
  orcamento               Float
  tipoDeOrcamento         String
  status                  String
  motivosDoStatus         String
  pontuacaoDeOtimizacao   Float
  tipoDeCampanha          String
  impressoes              Int
  ctr                     String
  custo                   Float
  tipoDeEstrategiaDeLances String
  cliques                 Int
  taxaDeConversao         String
  conversoes              String
  cpcMedio                Float
  custoPorConversao       String
}
