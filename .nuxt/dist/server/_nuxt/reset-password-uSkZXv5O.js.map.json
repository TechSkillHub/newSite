{"file":"reset-password-uSkZXv5O.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;AAmCM,UAAA,YAAY,IAAI,KAAK;AAE3B,UAAM,QAAQ,SAAS;AACjB,UAAA,QAAQ,MAAM,MAAM;AAEpB,UAAA,cAAc,IAAI,EAAE;AAE1B,UAAM,WAAW,YAAW;AAC1B,YAAM,OAAO;AAAA,QACX,aAAa,YAAY;AAAA,QACzB;AAAA,MACF;AACA,YAAM,cAAc,IAAI;AAAA,IAC1B;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../components/forms/ResetPassword.vue"],"sourcesContent":["<template>\r\n  <div class=\"border border-grayTheme rounded-md p-8 bg-gray-100 w-full md:w-1/2 lg:w-1/3\">\r\n    <Form \r\n      v-slot=\"{ errors, isSubmitting }\"\r\n      @submit.prevent=\"onSubmit\" \r\n      class=\"w-full flex flex-col gap-4\"\r\n    >\r\n      <FieldInput\r\n        label=\"New Password\" \r\n        name=\"password\" \r\n        id=\"password\" \r\n        type=\"password\"\r\n        rules=\"required|password\"\r\n        v-model=\"newPassword\" \r\n        :disabled=\"isSubmitting\" \r\n        :has-error=\"!!errors.name\" \r\n      />\r\n\r\n      <FieldButton\r\n        :disabled=\"isLoading\"\r\n        fullWidth\r\n        type=\"submit\"\r\n      >\r\n        Redefinir senha\r\n      </FieldButton>\r\n    </Form>\r\n\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { Form } from 'vee-validate';\r\n\r\nimport { resetPassword } from '~/services/auth.service';\r\n\r\nconst isLoading = ref(false);\r\n\r\nconst route = useRoute();\r\nconst token = route.query.token;\r\n\r\nconst newPassword = ref('');\r\n\r\nconst onSubmit = async() => {\r\n  const body = {\r\n    newPassword: newPassword.value,\r\n    token: token\r\n  }\r\n  await resetPassword(body)\r\n}\r\n\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>"],"version":3}