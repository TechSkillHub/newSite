{"file":"proposta-B8j-8LsO.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;AAeI,SAAK,eAAe,aAAa;;;;;;;;;;;;;;;;;;;ACMrC,SAAK,eAAe,aAAa;;;;;;;;;;;;;;;;;;;ACEjC,SAAK,eAAe,aAAa;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;","names":[],"sources":["../../../../components/section/Proposta/index.vue","../../../../components/section/Proposta/QuemSomos.vue","../../../../components/section/Proposta/Funil.vue"],"sourcesContent":["<template>\r\n  <div id=\"capa\" class=\"bg-offWhite h-screen overflow-x-hidden flex justify-center items-center\">\r\n    <div class=\"max-w-screen-lg grid gap-8 h-fit text-center\">\r\n      <h1 class=\"text-5xl title uppercase\">Proposta Comercial</h1>\r\n      <h1 class=\"text-3xl title\">(Serviço Oferecido)</h1>\r\n      <h1 class=\"text-7xl title uppercase text-primary font-bold mt-8\">(Cliente)</h1>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { gsap } from \"gsap\";\r\n    \r\n    import { ScrollTrigger } from \"gsap/ScrollTrigger\";\r\n    \r\n    gsap.registerPlugin(ScrollTrigger);\r\n    \r\n    onMounted(() => {\r\n      gsap.from('#capa .title', {\r\n        y: 100,\r\n        opacity: 0,\r\n        duration: 1.5,\r\n        ease: 'power2.out',\r\n        delay: 0.5,\r\n        stagger: 0.5,\r\n        scrollTrigger: {\r\n          toggleActions: 'play reverse play reverse',\r\n          trigger: '#capa',\r\n          start: 'top center',\r\n          end: 'bottom center',\r\n        },\r\n      });\r\n    });\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>","<template>\r\n  <div id=\"quem-somos\" class=\"bg-offWhite h-screen overflow-x-hidden flex justify-center items-center\">\r\n    <div class=\"max-w-screen-lg grid grid-flow-col gap-8 items-center h-fit\">\r\n      <img :src=\"logo\" alt=\"Logo\" class=\"w-80 h-80 logo\">\r\n  \r\n      <div class=\"grid grid-flow-row h-full gap-8\">\r\n        <h1 class=\"text-5xl title font-semibold\">Quem é a <span class=\"text-primary font-theme font-normal\">Tech Skill Hub</span>?</h1>\r\n        <p class=\"text-2xl\">\r\n          A <span class=\"text-primary font-theme\">TSH</span> foi criada quando identificamos a dificuldade de diversos setores em se posicionar no digital, assim surgiu nosso nome onde a ideia é juntar diversas habilidades em um único lugar de modo que podemos ajudar nosso clientes em toda a a jornada deles no universo do digital.\r\n        </p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport logo from \"~/assets/images/logo.svg\"\r\nimport { gsap } from \"gsap\";\r\n    \r\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\r\n\r\ngsap.registerPlugin(ScrollTrigger);\r\n\r\nonMounted(() => {\r\n  gsap.from('#quem-somos .title', {\r\n    y: -100,\r\n    opacity: 0,\r\n    duration: 1.5,\r\n    ease: 'power2.out',\r\n    delay: 1,\r\n    stagger: 0.5,\r\n    scrollTrigger: {\r\n      toggleActions: 'play reverse play reverse',\r\n      trigger: '#quem-somos',\r\n      start: 'top center',\r\n      end: 'bottom center',\r\n    },\r\n  });\r\n  gsap.from('#quem-somos p', {\r\n    x: 500,\r\n    opacity: 0,\r\n    duration: 1.5,\r\n    ease: 'power2.out',\r\n    delay: 1,\r\n    stagger: 0.5,\r\n    scrollTrigger: {\r\n      toggleActions: 'play reverse play reverse',\r\n      trigger: '#quem-somos',\r\n      start: 'top center',\r\n      end: 'bottom center',\r\n    },\r\n  });\r\n  gsap.from('#quem-somos .logo', {\r\n    x: -500,\r\n    opacity: 0,\r\n    duration: 1.5,\r\n    ease: 'power2.out',\r\n    delay: 1,\r\n    stagger: 0.5,\r\n    scrollTrigger: {\r\n      toggleActions: 'play reverse play reverse',\r\n      trigger: '#quem-somos',\r\n      start: 'top center',\r\n      end: 'bottom center',\r\n    },\r\n  });\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n\r\n</style>","<template>\r\n  <div id=\"funil\" class=\"bg-offWhite h-screen overflow-x-hidden flex justify-center items-center\">\r\n    <div class=\"max-w-screen-xl grid grid-flow-col gap-8 items-center h-fit\">  \r\n      <div class=\"grid grid-flow-row h-full gap-8\">\r\n        <h1 class=\"text-5xl title font-semibold uppercase leading-tight\">Começando a sua <span class=\"text-primary font-theme font-normal\">revolução digital</span></h1>\r\n        <h2 class=\"title text-2xl\">Funil de Vendas Ideal:</h2>\r\n        <div class=\"funnel\">\r\n          <div class=\"funnel-part\">SEO, Ads e Redes Sociais</div>\r\n          <div class=\"funnel-part\">Site e LandingPage</div>\r\n          <div class=\"funnel-part\">WhatsApp</div>\r\n          <div class=\"funnel-part\">Venda</div>\r\n          <!-- <div class=\"funnel-part\"></div> -->\r\n      </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup lang=\"ts\">\r\nimport { gsap } from \"gsap\";\r\n    \r\nimport { ScrollTrigger } from \"gsap/ScrollTrigger\";\r\n\r\ngsap.registerPlugin(ScrollTrigger);\r\n\r\nonMounted(() => {\r\n  gsap.from('#funil .title', {\r\n    y: -100,\r\n    opacity: 0,\r\n    duration: 1.5,\r\n    ease: 'power2.out',\r\n    delay: 1,\r\n    stagger: 0.5,\r\n    scrollTrigger: {\r\n      toggleActions: 'play reverse play reverse',\r\n      trigger: '#funil',\r\n      start: 'top center',\r\n      end: 'bottom center',\r\n    },\r\n  });\r\n  gsap.from('#funil .funnel-part', {\r\n    x: 100,\r\n    opacity: 0,\r\n    duration: 1.5,\r\n    ease: 'power2.out',\r\n    delay: 1.5,\r\n    stagger: 0.5,\r\n    scrollTrigger: {\r\n      toggleActions: 'play reverse play reverse',\r\n      trigger: '#funil',\r\n      start: 'top center',\r\n      end: 'bottom center',\r\n    },\r\n  });\r\n  \r\n});\r\n</script>\r\n\r\n<style scoped>\r\n.funnel {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    width: 500px;\r\n    margin: auto;\r\n}\r\n\r\n.funnel-part {\r\n    width: 100%;\r\n    height: 80px;\r\n    background: #4A90E2;\r\n    clip-path: polygon(2% 0%, 98% 0%, 90% 100%, 10% 100%);\r\n    color: white;\r\n    display: fl